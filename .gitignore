## Ignore Visual Studio temporary files, build results, and add‑on files
# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# MonoDevelop/Xamarin
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# Code coverage
*.coverage
*.coveragexml

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Azure publish settings
*.pubxml
*.publishproj
PublishScripts/

# Others
.sass-cache/
*.dbmdl
node_modules/
bower_components/
